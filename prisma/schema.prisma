generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id              Int      @id @default(1)
  heroEyebrow     String
  heroTitle       String
  heroDescription String
  heroCta         String
  heroImageUrl    String?
  showSponsors    Boolean  @default(true)
  valuesTitle     String   @default("ارزش‌های ما")
  valuesTagline   String   @default("تقویت ریشه‌هایمان | پرورش انگیزه‌مان | رسیدن به هدف واقعی‌مان")
  mapEyebrow      String   @default("یک شبکه، به وسعت ایران")
  mapTitle        String   @default("هر نقطه، یک فرصت\nبرای رشد و آبادانی")
  mapDescription  String   @default("از شمال تا جنوب، کنار تولیدکنندگان و همراهان محلی هستیم تا هیچ ظرفیت ارزشمندی دور از نگاه نماند.")
  mapStatNumber   String   @default("۳۱")
  mapStatLabel    String   @default("استان در مسیر همراهی")
  mapCaption      String   @default("ایران سرزمین مردان آزاد")
  storyTitle      String   @default("کشاورزیار این‌طوری شروع شد که")
  storyContent    String   @default("کشاورزیار از یک باور ساده شکل گرفت؛ اینکه ظرفیت‌های ارزشمند روستاهای ایران، شایسته دیده‌شدن و رشد هستند. ما تلاش می‌کنیم میان کشاورزان پرتلاش و همراهانی که دغدغه آبادانی دارند، پلی مطمئن و ماندگار بسازیم.")
  updatedAt       DateTime @updatedAt
}

model Stage {
  id          Int    @id @default(autoincrement())
  number      Int    @unique
  title       String
  description String
  iconImageUrl String?
}

model CoreValue {
  id          Int    @id @default(autoincrement())
  order       Int    @unique
  title       String
  description String
  iconImageUrl String?
}

model MapProject {
  id          Int    @id @default(autoincrement())
  order       Int    @unique
  title       String
  description String
  status      String
}

model Sponsor {
  id       Int     @id @default(autoincrement())
  order    Int     @unique
  name     String
  label    String
  href     String
  imageUrl String?
}

model Submission {
  id               Int      @id @default(autoincrement())
  type             String
  name             String
  phone            String
  province         String?
  city             String?
  village          String?
  product          String?
  collaboration    String?
  createdAt        DateTime @default(now())
}

model Province {
  id     Int    @id @default(autoincrement())
  name   String @unique
  cities City[]
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([provinceId, name])
}
